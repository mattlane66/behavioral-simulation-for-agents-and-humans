{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavioral Simulation Calibration",
  "type": "object",
  "required": ["schema_version","status","model_scope","decision_metric","decision_threshold","validation_ids","split_method","error_prediction_metrics","buckets","freshness","notes"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"enum": ["NOT_ATTEMPTED","IN_PROGRESS","VALID","INVALID","STALE"]},
    "model_scope": {"type": "string"},
    "decision_metric": {"type": ["string","null"]},
    "decision_threshold": {"type": ["number","null"]},
    "validation_ids": {"type": "array","items": {"type": "string","pattern": "^V[0-9]{3,}$"}},
    "split_method": {"type": "string"},
    "error_prediction_metrics": {"type": "object"},
    "buckets": {"type": "array","items": {"type": "object"}},
    "freshness": {"type": "object"},
    "notes": {"type": "array","items": {"type": "string"}}
  },
  "additionalProperties": false
}
