{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavioral Simulation Evidence Ledger",
  "type": "object",
  "required": ["schema_version","entries"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","evidence_type","claim","source","provenance","use","held_out","population_scope","time_scope","notes"],
        "properties": {
          "id": {"type": "string","pattern": "^E[0-9]{3,}$"},
          "evidence_type": {"enum": ["OBSERVED_HUMAN","NONHUMAN_CONTEXT","ASSUMPTION","SIMULATED_ESTIMATE","CALIBRATION_EVIDENCE"]},
          "claim": {"type": "string","minLength": 1},
          "source": {"type": ["string","null"]},
          "provenance": {"type": "string"},
          "use": {"enum": ["GROUNDING","TRAINING","VALIDATION","CALIBRATION","CONTEXT","SCENARIO"]},
          "held_out": {"type": "boolean"},
          "population_scope": {"type": "string"},
          "time_scope": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
