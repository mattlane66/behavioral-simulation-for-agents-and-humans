{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavioral Simulation Validations",
  "type": "object",
  "required": ["schema_version","entries"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","run_id","correctness_unit","metric","predicted","observed","computed_error","held_out","split_unit","split_group","population_match","time_match","subgroup","notes"],
        "properties": {
          "id": {"type": "string","pattern": "^V[0-9]{3,}$"},
          "run_id": {"type": "string","pattern": "^R[0-9]{3,}$"},
          "correctness_unit": {"enum": ["INDIVIDUAL","DISTRIBUTION","TREATMENT_EFFECT","SYSTEM_TRAJECTORY"]},
          "metric": {"enum": ["TVD","ABSOLUTE_ERROR","ACCURACY","CORRELATION","OTHER"]},
          "predicted": {"type": ["object","number","array"]},
          "observed": {"type": ["object","number","array"]},
          "computed_error": {"type": ["number","null"],"minimum": 0},
          "held_out": {"type": "boolean"},
          "split_unit": {"enum": ["PERSON","QUESTION","STUDY","CONDITION","TIME","GEOGRAPHY","OTHER"]},
          "split_group": {"type": "string"},
          "population_match": {"enum": ["MATCH","PARTIAL","MISMATCH","UNKNOWN"]},
          "time_match": {"enum": ["MATCH","PARTIAL","MISMATCH","UNKNOWN"]},
          "subgroup": {"type": ["string","null"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
